# =============================================================================
# VARIABLES DE ENTORNO - ECOWASH DIRECT
# NUNCA ALMACENAR CREDENCIALES REALES EN EL CÓDIGO O CONTROL DE VERSIONES
# =============================================================================

# Pasarela de Pagos (Modo Simulado / Demostración)
# No requiere claves API externas ni credenciales de Stripe/PayPal
PAYMENT_MODE=SIMULATED

# Configuración SMTP (Gmail App Password)
# Para generar App Password de Gmail:
# 1. Ve a https://myaccount.google.com/security (activa verificación en 2 pasos)
# 2. Ve a https://myaccount.google.com/apppasswords
# 3. Genera una contraseña para "Correo" y pégala aquí (16 caracteres sin espacios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_16_caracteres
SMTP_FROM_NAME=EcoWash Direct
SMTP_FROM_EMAIL=noreply@ecowash.bo

# Configuración del Sistema
PAYMENT_CURRENCY=BOB
APP_BASE_URL=http://localhost:5173
